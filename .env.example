# Copy to .env.local and fill in values.
#
# NOTE: every NEXT_PUBLIC_* value below must also be set in the Netlify UI for
# production. netlify.toml only sets NEXT_PUBLIC_APP_URL, and both Firebase
# clients fail *silently* when their key is missing (lib/pholio-auth/firebase.ts
# returns null), so a missing variable shows up as "auth quietly does nothing"
# rather than an error.

# ---------------------------------------------------------------------------
# Pholio app origin — every CTA on this site links here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# API proxy target for the /api/:path* rewrite in next.config.ts.
#
# This site does NOT call the app cross-origin: Next proxies /api/* server-side
# to the Express backend. Session cookies reach it because the app sets them on
# the shared `.pholio.studio` scope and the proxy forwards the Cookie header.
#
# Defaults to http://localhost:3000 in development (matching pholio-app's
# .env.example PORT) and to NEXT_PUBLIC_APP_URL in production.
# ---------------------------------------------------------------------------
# APP_BACKEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Firebase Web SDK — same Firebase project as pholio-app.
# The app reads these as FIREBASE_* / VITE_FIREBASE_*; this site needs the
# NEXT_PUBLIC_ prefix. Same project, three naming schemes.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
